---
layout: layouts/base.njk
---
<article class="post">
	<header class="post-header">
		<h1>{{ title }}</h1>
		{% if subtitle %}
			<p class="post-subtitle">{{ subtitle }}</p>
		{% endif %}
		<p class="post-meta">
			<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
		</p>
	</header>
	<div class="post-body">
		{{ content | safe }}
	</div>
</article>
<p class="post-nav">
	<a href="/">← All posts</a>
</p>
