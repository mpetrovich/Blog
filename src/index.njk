---
layout: layouts/base.njk
permalink: /
---
<section class="intro">
	<p>
		Michael Petrovich. Twenty years across engineering, product, and leadership.
		Writing at the intersection of product, engineering, and data.
		<a href="{{ site.linkedin }}">LinkedIn</a>
		·
		<a href="{{ site.github }}">GitHub</a>
	</p>
</section>

<section class="post-list" aria-label="Posts">
	<ul>
		{%- for post in collections.posts %}
		<li>
			<a href="{{ post.url }}">{{ post.data.title }}</a>
			<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
		</li>
		{%- endfor %}
	</ul>
</section>
