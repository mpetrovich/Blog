{
  "useTabs": false,
  "tabWidth": 4,
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-nunjucks"],
  "overrides": [
    {
      "files": ["*.json", "*.md", "*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.njk", "*.nunjucks", "*.nunj"],
      "options": {
        "parser": "nunjucks"
      }
    }
  ]
}
