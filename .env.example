# Copy to .env and fill in. Never commit .env.
# See README “Email subscribe (Buttondown)”.

# Required for /blog-notify-subscribers and site/scripts/notify-subscribers.mjs
BUTTONDOWN_API_KEY=

# Optional: overrides site.js default for the subscribe form embed username
# BUTTONDOWN_USERNAME=mpetrovich

# Optional
# SITE_URL=https://petro.blog
# POSTS_DIR=