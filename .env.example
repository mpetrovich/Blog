# Copy to .env and fill in. Never commit .env.
# See docs/buttondown-setup.md

# Required for /notify-subscribers and site/scripts/notify-subscribers.mjs
BUTTONDOWN_API_KEY=

# Optional: overrides site.js default for the subscribe form embed username
# BUTTONDOWN_USERNAME=mpetrovich

# Optional
# SITE_URL=https://petro.blog
# POSTS_DIR=