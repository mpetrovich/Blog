{%- if site.buttondownUsername %}
    <section class='status-page' aria-labelledby='subscribe-heading'>
        {%- if subscribePage %}
            <h1 id='subscribe-heading'>Subscribe</h1>
        {%- else %}
            <h2 id='subscribe-heading'>Subscribe</h2>
        {%- endif %}
        <p>Get notified of new posts. No spam.</p>
        <form
            class='subscribe-form'
            action='https://buttondown.com/api/emails/embed-subscribe/{{ site.buttondownUsername }}'
            method='post'
        >
            <div class='subscribe-row'>
                <input
                    id='subscribe-email'
                    class='subscribe-input'
                    type='email'
                    name='email'
                    placeholder='you@example.com'
                    autocomplete='email'
                    aria-label='Email address'
                    required
                />
                <button class='subscribe-button' type='submit'>Subscribe</button>
            </div>
            <input type='hidden' name='embed' value='1' />
            <input type='hidden' name='next' value='{{ site.url }}/subscribe/unconfirmed/' />
        </form>
    </section>
{%- endif %}
