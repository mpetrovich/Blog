<!DOCTYPE html>
<html lang='en'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <title>
            {%- if title and title != site.title -%}
                {{ title }} · {{ site.title }}
            {%- else -%}
                {{ site.title }}
            {%- endif -%}
        </title>
        <meta name='description' content='{{ description or subtitle or site.description }}' />
        {%- if noindex %}
            <meta name='robots' content='noindex, nofollow' />
        {%- endif %}
        <link rel='icon' href='/favicon.png' type='image/png' sizes='32x32' />
        <link rel='icon' href='/favicon-192.png' type='image/png' sizes='192x192' />
        <link rel='icon' href='/favicon-512.png' type='image/png' sizes='512x512' />
        <link rel='apple-touch-icon' href='/apple-touch-icon.png' sizes='180x180' />
        <link
            rel='preload'
            href='/fonts/ibm-plex-serif-latin-400-normal.woff2'
            as='font'
            type='font/woff2'
            crossorigin
        />
        <style>{{ cssInline | safe }}</style>
    </head>
    <body class='design-compare' data-theme-persist='false'>
        <a class='skip-link' href='#main'>Skip to content</a>
        <div class='design-compare-pane'>
            <header class='site-header'>
                <nav class='breadcrumbs' aria-label='Breadcrumb'>
                    <a href='/'>{{ site.title }}</a>
                    <span class='crumb-slash' aria-hidden='true'>/</span>
                </nav>
            </header>
            <main id='main' class='site-main'>{{ content | safe }}</main>
            {% include "site-footer.njk" %}
        </div>
        <script type='module'>
            const boot = () =>
                Promise.all([import('/js/theme-toggle.js'), import('/js/design-orb-controls.js')])
            if (document.readyState === 'complete') boot()
            else window.addEventListener('load', boot)
        </script>
    </body>
</html>
