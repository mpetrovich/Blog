---
layout: layouts/base.njk
---
<article class="post">
	<header class="post-header">
		<h1>{{ title }}</h1>
		{% if subtitle %}
			<p class="post-subtitle">{{ subtitle }}</p>
		{% endif %}
		<p class="post-meta">
			<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
			{%- if tags and tags.length %}
				<span class="post-tags" aria-label="Tags">
					{%- for tag in tags %}
						{%- if not loop.first %} · {% endif %}<a href="/tags/{{ tag }}/">{{ tag }}</a>
					{%- endfor %}
				</span>
			{%- endif %}
		</p>
	</header>
	<div class="post-body">
		{{ content | safe }}
	</div>
</article>
