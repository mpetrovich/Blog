---
layout: layouts/base.njk
permalink: /
---

<section class='intro band'>
    <p class='lede'>
        <strong>Michael Petrovich</strong>. Working and writing at the intersection of engineering, product, and data.
    </p>
    <p class='meta'><a href='{{ site.linkedin }}'>LinkedIn</a> · <a href='{{ site.github }}'>GitHub</a></p>
</section>

<section class='home-topics' aria-labelledby='home-topics-heading'>
    <header class='section-header'>
        <h2 id='home-topics-heading' class='title-section'>
            <a href='/topics/'>Topics</a>
        </h2>
    </header>
    <p class='meta topics-jumplist'>
        #
        {% for topicPage in collections.topicPages -%}
            {%- if not loop.first %}, {% endif -%}
            <a class='quiet-link' href='/topics/{{ topicPage.topic }}/'>{{ topicPage.topic }}</a>
        {%- endfor %}
    </p>
</section>

<section class='home-posts' aria-labelledby='home-posts-heading'>
    <header class='section-header -split'>
        <h2 id='home-posts-heading' class='title-section'>
            <a href='/posts/'>Posts</a>
        </h2>
        <a class='meta quiet-link' href='/feed.xml'>RSS</a>
    </header>
    <section class='post-list -ruled' aria-label='Posts'>
        <ul>
            {%- for post in collections.posts %}
                <li>
                    <div class='post-list-main'>
                        <a href='{{ post.url }}'>{{ post.data.title }}</a>
                        {%- if post.data.subtitle %}
                            <p class='subtitle'>
                                {{ post.data.subtitle }}
                            </p>
                        {%- endif %}
                    </div>
                    <time class='meta' datetime='{{ post.date | isoDate }}'>{{ post.date | readableDate }}</time>
                </li>
            {%- endfor %}
        </ul>
    </section>
</section>
