---
layout: layouts/base.njk
pagination:
  data: collections.tagPages
  size: 1
  alias: tagPage
permalink: /tags/{{ tagPage.tag }}/
eleventyComputed:
  title: "{{ tagPage.tag }}"
---

<section class="tag-archive">
	<header class="tag-archive-header">
		<h1>{{ tagPage.tag }}</h1>
	</header>
	<section class="post-list" aria-label="Posts tagged {{ tagPage.tag }}">
		<ul>
			{%- for post in tagPage.posts %}
				<li>
					<div class="post-list-main">
						<a href="{{ post.url }}">{{ post.data.title }}</a>
						{%- if post.data.subtitle %}
							<p class="post-list-subtitle">{{ post.data.subtitle }}</p>
						{%- endif %}
					</div>
					<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
				</li>
			{%- endfor %}
		</ul>
	</section>
</section>
