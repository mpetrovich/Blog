---
layout: layouts/base.njk
permalink: /posts/
title: Posts
postsIndex: true
eleventyExcludeFromCollections: true
---

<section class='posts-landing'>
    <section class='post-list -ruled' aria-label='Posts'>
        <ul>
            {%- for post in collections.posts %}
                <li>
                    <div class='post-list-main'>
                        <a href='{{ post.url }}'>{{ post.data.title }}</a>
                        {%- if post.data.subtitle %}
                            <p class='subtitle'>
                                {{ post.data.subtitle }}
                            </p>
                        {%- endif %}
                    </div>
                    <time class='meta' datetime='{{ post.date | isoDate }}'>{{ post.date | readableDate }}</time>
                </li>
            {%- endfor %}
        </ul>
    </section>
</section>
